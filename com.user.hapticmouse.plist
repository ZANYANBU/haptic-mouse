<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.hapticmouse</string>
    <!-- Default location; install.sh rewrites this to wherever HapticMouse.app is installed. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/HapticMouse.app/Contents/MacOS/HapticMouse</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
